    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "publint": "^0.3.25",
    "react": "^18.1.0",
    "react-dom": "^18.1.0",
    "size-limit": "^14.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
