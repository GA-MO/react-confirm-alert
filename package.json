    "react"
  ],
  "author": "Thawatchai Kuansombat (thawatchai.deartk@gmail.com)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/GA-MO/react-confirm-alert/issues"
  },
  "homepage": "https://github.com/GA-MO/react-confirm-alert",
