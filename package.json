  "files": [
    "lib",
    "dist",
    "typings",
    "src/react-confirm-alert.css",
    "index.d.ts"
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@size-limit/preset-small-lib": "^14.3.0",
